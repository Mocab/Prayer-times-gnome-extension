<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.prayertimes" path="/org/gnome/shell/extensions/prayertimes/">
        <key name="auto-location" type="b">
            <summary>Automatic location</summary>
            <default>true</default>
            <description>Automatically detect location (latitude and longitude)</description>
        </key>
        <key name="latitude" type="d">
            <summary>Latitude</summary>
            <default>0.0000</default>
            <range min="-90" max="90"/>
            <description>Custom latitude (earth y axis)</description>
        </key>
        <key name="longitude" type="d">
            <summary>Longitude</summary>
            <default>0.0000</default>
            <range min="-180" max="180"/>
            <description>Custom longitude (earth x axis)</description>
        </key>

        <key name="preset-methods" type="s">
            <summary>Preset methods</summary>
            <default>'mwl'</default>
            <description>Preset Fajr and Isha calculation methods</description>
        </key>
        <key name="fajr-method" type="d">
            <summary>Fajr method</summary>
            <default>18</default>
            <range min="0" max="20"/>
            <description>Set a custom Fajr calculation method</description>
        </key>
        <key name="isha-method" type="d">
            <summary>Isha method</summary>
            <default>17</default>
            <range min="0" max="20"/>
            <description>Set a custom Isha calculation method</description>
        </key>
        <key name="asr-method" type="s">
            <summary>Asr shadow method</summary>
            <default>'standard'</default>
            <description>Set the Asr shadow calculation method</description>
        </key>
        <key name="high-latitude-adjustment" type="s">
            <summary>High latitude adjustment</summary>
            <default>'night-middle'</default>
            <description>Set the high latitude adjustment method</description>
        </key>
        <key name="include-sunnah" type="b">
            <summary>Include sunnah prayers</summary>
            <default>true</default>
            <description>Show times for sunnah prayers</description>
        </key>
        <key name="use-local-calc" type="b">
            <summary>Use local calculation</summary>
            <default>true</default>
            <description>Calculate prayer times locally based on location</description>
        </key>

        <key name="prayer-names" type="s">
            <summary>Custom prayer names</summary>
            <default>'{"fajr":"Fajr","duha":"Duha","dhuhr":"Dhuhr","asr":"Asr","maghrib":"Maghrib","isha":"Isha","jummah":"Jummah"}'</default>
            <description>JSON object with custom names for each prayer</description>
        </key>

        <key name="use-am-pm" type="b">
            <summary>Use AM/PM format</summary>
            <default>false</default>
            <description>Override GNOME clock format to use AM/PM</description>
        </key>
        <key name="display-mode" type="s">
            <summary>Display mode</summary>
            <default>'countdown'</default>
            <description>How to display the next prayer: countdown or clock-time</description>
        </key>

        <key name="use-mawaqit" type="b">
            <summary>Use Mawaqit for prayer times</summary>
            <default>false</default>
            <description>Fetch prayer times from Mawaqit instead of calculating locally</description>
        </key>
        <key name="mawaqit-slug" type="s">
            <summary>Mawaqit mosque slug</summary>
            <default>''</default>
            <description>The slug of the selected Mawaqit mosque</description>
        </key>
        <key name="mawaqit-label" type="s">
            <summary>Mawaqit mosque label</summary>
            <default>''</default>
            <description>The display name of the selected Mawaqit mosque</description>
        </key>

        <key name="notify-prayer" type="b">
            <summary>Send notifications</summary>
            <default>true</default>
            <description>Send a notification for reminders and prayers</description>
        </key>
        <key name="sound-player" type="b">
            <summary>Play a sound for prayers</summary>
            <default>true</default>
            <description>Play a sound for each prayer</description>
        </key>
        <key name="reminder" type="i">
            <summary>Notify before prayer</summary>
            <default>0</default>
            <range min="0" max="15"/>
            <description>Number of minutes before a prayer to send a notification</description>
        </key>
    </schema>
</schemalist>